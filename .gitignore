# Generated reports — the morning routine rebuilds these; do not commit churn.
reports/
*.sitrep.html

# dashboard.html is the exception: it is the product, and it is committed.
!dashboard.html

# Secrets stay out of the repo and out of the agent's context.
.env
.env.*
# .env.example documents the required vars with no real secret — it is committed.
!.env.example

# Next.js build output (ADR 0011 — the deployed app has a build step).
.next/
# Auto-generated by Next/tsc on every build — churn, not source.
next-env.d.ts
*.tsbuildinfo

# Language debris — extend for whichever toolchain you pick in CLAUDE.md.
__pycache__/
.venv/
node_modules/
.DS_Store

# Partial snapshot writes (writeSnapshot writes <name>.tmp-* then renames).
data/*.tmp-*

# Agent/tooling scratch state — personal, not project source.
.agents/
.superpowers/
.claude/settings.local.json
skills-lock.json

# Vercel CLI local link + build state (ADR 0011). Env files are already handled
# by the .env / .env.* block above (keeps .env.local out, .env.example in).
.vercel
